<policies>
    <inbound>
        <base />
        <!-- Team Alpha: high rate limit — production workloads -->
        <!-- Replace with llm-token-limit after importing Foundry API via portal -->
        <rate-limit-by-key calls="500" renewal-period="60"
            counter-key="@(context.Subscription.Id)" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
